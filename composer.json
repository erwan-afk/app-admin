{
  "name": "media-start/auth-admin",
  "description": "Console d'administration (users, rôles, clients OAuth2) — extraite d'auth_global le 2026-07-18",
  "license": "MIT",
  "require": {
    "php": "^8.0",
    "ext-json": "*",
    "ext-curl": "*",
    "jasny/immutable": "^2.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "MediaStart\\Auth\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.32"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
